---
/** Filmstrip and lightbox, in one piece.
 *
 *  Click a picture, leaf through with the arrows, the arrow keys or a swipe,
 *  pinch to zoom, escape or the back button to leave.
 *
 *  THE SLIDES ARE RENDERED HERE, IN THE TEMPLATE. That is not a detail. A
 *  version of this built its slides at runtime and shipped broken: Astro
 *  scopes component CSS by stamping a `data-astro-…` attribute on the
 *  elements it finds in the template and rewriting every selector to match
 *  it, so elements made later by script are reached by nothing. The frame
 *  looked right and the pictures were a row of broken icons.
 *
 *  The script, on the other hand, must NOT assume the markup is there when
 *  it runs. Astro hoists it into the page bundle, and a gallery inside a
 *  `server:defer` island arrives afterwards. So it binds nothing up front:
 *  one delegated listener on the document, and each gallery is set up the
 *  first time someone touches it.
 */
import type { GalleryImage, GalleryLabels } from './types.ts';

interface Props {
  images: GalleryImage[];
  labels: GalleryLabels;
  /** `sizes` for the strip thumbnails. */
  sizes?: string;
  /** Put on the root, so a site can style its own gallery. */
  class?: string;
  /** Round and round: after the last picture comes the first again, and
   *  before the first the last — in the enlarged view and, since 1.5.0, in
   *  the strip too (arrows, swipe, trackpad). Off by default — with six
   *  pictures the loop is a nicety, with two it is a merry-go-round. */
  loop?: boolean;
  /** The clicked picture grows out of the strip into the enlarged view, and
   *  goes back to its place on closing. On by default since 1.4.0: it only
   *  moves a stand-in via transform and stays still for reduced motion.
   *  `fly={false}` for a gallery that should open without the journey. */
  fly?: boolean;
  /** The pictures of the strip settle in (rise and fade, one after the other)
   *  while the strip scrolls into view. Pure CSS, bound to the scroll
   *  position; on by default because it only moves transform and opacity and
   *  ends in the state the page would have had anyway. `reveal={false}` for
   *  a gallery that must stand still. */
  reveal?: boolean;
}

const { images, labels, sizes = '22rem', class: extra = '', loop = false, fly = true, reveal = true } = Astro.props;

/** More than one gallery on a page is allowed, so nothing here is an id. */
const words = (image: GalleryImage, i: number) => image.alt.trim() || `${labels.open} ${i + 1}`;

/** The endless strip is the set three times over: a copy before and after the
 *  real one, so there is always a picture on either side. The script keeps
 *  the scroll position inside the middle set and, once the strip has come to
 *  rest, moves it by exactly one set — the same pictures stand in the same
 *  places, so nothing visible happens. The copies are rendered here, not by
 *  script, for the same reason as the slides (see above). They are hidden from
 *  screen readers and the tab order; `data-ag-open` keeps the REAL index, so
 *  the enlarged view always opens on the right picture. */
const copies = loop && images.length > 1 ? [-1, 0, 1] : [0];
---
<div class:list={['ag', extra]} data-ag data-ag-loop={loop ? '' : undefined}
     data-ag-fly={fly ? '' : undefined} data-ag-reveal={reveal ? '' : undefined}>
  <div class="ag-band">
    <ul class="ag-strip" data-ag-strip>
      {copies.map((copy) => images.map((image, i) => (
        <li class="ag-frame" data-ag-copy={copy ? String(copy) : undefined}
            aria-hidden={copy ? 'true' : undefined} style={`--ag-i: ${Math.min(i, 4)}`}>
          <button type="button" class="ag-open" data-ag-open={i} aria-label={labels.open}
            tabindex={copy ? -1 : undefined}>
            <img src={image.thumb} srcset={image.srcset} sizes={sizes} alt={copy ? '' : words(image, i)}
              width={image.width} height={image.height} loading="lazy" decoding="async" />
          </button>
        </li>
      )))}
    </ul>

    {/* Below the strip, not beside it: beside it they stood at the window
        edge and over the pictures. `--ag-edge` puts them on the page's
        content edge. */}
    <div class="ag-steps">
      <button type="button" class="ag-step ag-step-prev" data-ag-step="-1" aria-label={labels.prev}>‹</button>
      <button type="button" class="ag-step ag-step-next" data-ag-step="1" aria-label={labels.next}>›</button>
    </div>
  </div>

  <div class="ag-big" data-ag-big aria-hidden="true">
    <button type="button" class="ag-btn ag-close" data-ag-close aria-label={labels.close}>✕</button>
    <button type="button" class="ag-btn ag-prev" data-ag-go="-1" aria-label={labels.prev}>‹</button>

    <div class="ag-view" data-ag-view>
      <div class="ag-track" data-ag-track>
        {images.map((image, i) => (
          <div class="ag-slide">
            <img class="ag-photo" data-src={image.full} alt={words(image, i)} draggable="false"
              data-w={image.width} data-h={image.height} />
            {/* Part of the slide, so it travels with its picture and needs no
                script. Only where a picture has something to say. */}
            {image.caption?.trim() && <p class="ag-caption">{image.caption}</p>}
          </div>
        ))}
      </div>
    </div>

    <button type="button" class="ag-btn ag-next" data-ag-go="1" aria-label={labels.next}>›</button>
    <p class="ag-count"><span data-ag-at>1</span> / <span>{images.length}</span></p>
  </div>
</div>

<script>
  /** Everything one open gallery needs to remember. */
  interface Live {
    root: HTMLElement;
    big: HTMLElement;
    view: HTMLElement;
    track: HTMLElement;
    slides: HTMLElement[];
    photos: HTMLImageElement[];
    at: HTMLElement;
    loop: boolean;
    fly: boolean;
    index: number;
    vw: number;
    scale: number;
    tx: number;
    ty: number;
  }

  const EASE = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
  const MAX_ZOOM = 4;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  /** Pictures that fade in when they have loaded, instead of appearing in
   *  pieces. Only a picture that is NOT there yet is held back
   *  (`data-ag-wait`, opacity 0): one that is already complete is left alone,
   *  and without script nothing is ever held back. When the file arrives the
   *  hold is lifted and `data-ag-in` plays a short fade (an animation, not a
   *  transition: the lightbox photo carries an inline `transition` for the
   *  zoom). An error lifts the hold too, so the alt text is not hidden.
   *  The stand-in of `fly` is not looked at — it is not a strip picture and
   *  not an `.ag-photo`. */
  const softly = (img: HTMLImageElement) => {
    if (img.complete || img.hasAttribute('data-ag-wait')) return;
    img.setAttribute('data-ag-wait', '');
    const lift = (ok: boolean) => {
      img.removeAttribute('data-ag-wait');
      // While a stand-in is still covering this picture it is swapped for it
      // at once; fading it up underneath would show as a flash.
      if (ok && !img.closest('[data-ag]')?.querySelector('.ag-ghost')) img.setAttribute('data-ag-in', '');
    };
    img.addEventListener('load', () => lift(true), { once: true });
    img.addEventListener('error', () => lift(false), { once: true });
  };
  const soften = (scope: ParentNode) => {
    for (const img of scope.querySelectorAll<HTMLImageElement>('.ag-open img, .ag-photo[src]')) softly(img);
  };
  /** The endless strip (`loop`). The strip holds the set three times; this
   *  keeps the scroll position in the middle one. The width of one set is
   *  measured from the layout every time — pictures load, fonts arrive, the
   *  window turns — and moving by exactly that width shows the same pictures
   *  in the same places. A set narrower than the strip cannot fill both sides,
   *  so the copies are put away (`data-ag-short`) and the strip has ends. */
  const span = (strip: HTMLElement) => {
    const lead = strip.querySelector<HTMLElement>('.ag-frame');
    const first = strip.querySelector<HTMLElement>('.ag-frame:not([data-ag-copy])');
    if (!lead || !first || lead === first) return 0;
    return first.getBoundingClientRect().left - lead.getBoundingClientRect().left;
  };
  const endless = (strip: HTMLElement) =>
    strip.closest('[data-ag]')?.hasAttribute('data-ag-loop') === true
    && !!strip.querySelector('[data-ag-copy]') && !strip.hasAttribute('data-ag-short');
  /** Back into the middle set. `instant`: a site may set smooth scrolling,
   *  and this move has to be invisible.
   *
   *  At rest the strip stands on a snap point, and one set further is a snap
   *  point too. In motion (a trackpad fling running into the end) it does
   *  not, and a mandatory snap type pulled the position to the nearest point
   *  the moment it was set — the pictures jumped. So in motion snapping is
   *  switched off for the move (`data-ag-loose`) and only switched back on
   *  once the strip has come to rest and been eased onto the nearest picture
   *  (`align`). */
  const recentre = (strip: HTMLElement, moving = false) => {
    if (!endless(strip)) return;
    const w = span(strip);
    if (w <= 0) return;
    if (w < strip.clientWidth) { strip.setAttribute('data-ag-short', ''); return; }
    // The middle of the view stays over the middle set, so what is seen is
    // nearly always the real pictures, and there is a set to either side.
    const x = strip.scrollLeft, centre = x + strip.clientWidth / 2;
    const to = centre < w ? x + w : centre > 2 * w ? x - w : x;
    if (to === x) return;
    if (moving) { strip.setAttribute('data-ag-loose', ''); strip.style.scrollSnapType = 'none'; }
    strip.scrollTo({ left: to, behavior: 'instant' });
  };
  /** After a loose move: glide onto the picture nearest the middle, then
   *  snapping is back on. Switched on off the point, the browser would snap
   *  there in one jump. */
  const align = (strip: HTMLElement) => {
    const s = strip.getBoundingClientRect(), mid = s.left + s.width / 2;
    let off = Infinity;
    for (const f of strip.querySelectorAll<HTMLElement>('.ag-frame')) {
      const r = f.getBoundingClientRect();
      if (!r.width) continue; // a copy put away
      const d = r.left + r.width / 2 - mid;
      if (Math.abs(d) < Math.abs(off)) off = d;
    }
    if (!Number.isFinite(off) || Math.abs(off) < 1) {
      strip.removeAttribute('data-ag-loose');
      strip.style.scrollSnapType = '';
      recentre(strip);
      return;
    }
    strip.scrollTo({ left: strip.scrollLeft + off, behavior: calm() ? 'instant' : 'smooth' });
    if (calm()) align(strip);
  };
  /** Strips scrolling right now: from the first scroll event to rest. */
  const motion = new WeakSet<HTMLElement>();
  /** The strip has come to rest. */
  const rest = (strip: HTMLElement) => {
    motion.delete(strip);
    if (strip.hasAttribute('data-ag-loose')) align(strip); else recentre(strip);
  };
  /** Where a fresh strip starts: the first picture of the middle set in the
   *  middle, the way the snap points stand. Retried until the strip has a
   *  layout (a hidden strip measures zero). */
  const begin = (strip: HTMLElement) => {
    if (strip.hasAttribute('data-ag-ring') || !endless(strip)) return;
    const w = span(strip);
    if (w <= 0) return;
    strip.setAttribute('data-ag-ring', '');
    if (w < strip.clientWidth) { strip.setAttribute('data-ag-short', ''); return; }
    const first = strip.querySelector<HTMLElement>('.ag-frame:not([data-ag-copy])')!;
    const s = strip.getBoundingClientRect(), f = first.getBoundingClientRect();
    strip.scrollTo({ left: strip.scrollLeft + f.left - s.left - (s.width - f.width) / 2, behavior: 'instant' });
  };
  const rings = (scope: ParentNode) => {
    for (const strip of scope.querySelectorAll<HTMLElement>('[data-ag-loop] [data-ag-strip]')) begin(strip);
  };
  /** Recentred once the strip has come to rest, never under a finger: moving
   *  the position in the middle of a touch breaks the gesture on iOS. Near a
   *  hard end it is done at once — a long fling must not run out of strip. */
  const resting = new WeakMap<HTMLElement, number>();
  let touching = 0;
  /** Nor while the mouse button is down on a strip. A click needs down and up
   *  on the same element; one set further is the same picture in the same
   *  place but another element, so the click was lost with nothing to see. */
  let pressed: HTMLElement | null = null;
  const busy = () => touching > 0 || pressed !== null;
  const later = (strip: HTMLElement) => {
    window.clearTimeout(resting.get(strip));
    resting.set(strip, window.setTimeout(() => { if (!busy()) rest(strip); }, 140));
  };
  document.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch' || e.button !== 0) return; // fingers: `touching`
    pressed = (e.target as Element).closest?.<HTMLElement>('[data-ag-strip]') ?? null;
  }, true);
  /** The rest timer, not at once: the click follows `pointerup`. */
  const letGo = () => {
    if (!pressed) return;
    later(pressed);
    pressed = null;
  };
  // A native drag ends in `pointercancel`; a context menu or another window
  // can swallow the release altogether.
  for (const type of ['pointerup', 'pointercancel', 'contextmenu']) document.addEventListener(type, letGo, true);
  window.addEventListener('blur', letGo);
  document.addEventListener('scroll', (e) => {
    const strip = e.target instanceof HTMLElement && e.target.matches('[data-ag-strip]') ? e.target : null;
    if (!strip || !endless(strip)) return;
    begin(strip);
    motion.add(strip);
    const w = span(strip), x = strip.scrollLeft;
    if (!pressed && w > 0 && (x < w * 0.15 || x + strip.clientWidth > w * 2.85)) recentre(strip, true);
    later(strip);
  }, true);
  document.addEventListener('scrollend', (e) => {
    if (e.target instanceof HTMLElement && e.target.matches('[data-ag-strip]') && !busy()) {
      window.clearTimeout(resting.get(e.target));
      rest(e.target);
    }
  }, true);
  document.addEventListener('touchstart', (e) => {
    if ((e.target as Element).closest?.('[data-ag-strip]')) touching++;
  }, { passive: true, capture: true });
  const untouch = (e: TouchEvent) => {
    const strip = (e.target as Element).closest?.<HTMLElement>('[data-ag-strip]');
    if (!strip) return;
    touching = Math.max(0, touching - 1);
    later(strip);
  };
  document.addEventListener('touchend', untouch, { passive: true, capture: true });
  document.addEventListener('touchcancel', untouch, { passive: true, capture: true });
  window.addEventListener('resize', () => {
    for (const strip of document.querySelectorAll<HTMLElement>('[data-ag-loop] [data-ag-strip]')) {
      strip.removeAttribute('data-ag-short');
      if (strip.hasAttribute('data-ag-ring')) recentre(strip); else begin(strip);
    }
  });

  // The markup may arrive later (a `server:defer` island), so watch for it.
  const arrivals = () => {
    soften(document);
    rings(document);
    if (typeof MutationObserver !== 'function') return;
    new MutationObserver((records) => {
      for (const r of records) for (const n of r.addedNodes) {
        if (n instanceof Element) {
          if (n.matches('[data-ag], [data-ag] *') || n.querySelector('[data-ag]')) {
            const scope = n.closest('[data-ag]') ?? n;
            soften(scope);
            rings(scope.parentNode ?? scope);
          }
        }
      }
    }).observe(document.documentElement, { childList: true, subtree: true });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', arrivals, { once: true });
  else arrivals();

  /** The gallery whose picture is open, if any. There is at most one. */
  let live: Live | null = null;
  /** Slides standing somewhere other than their own place, while a loop is
   *  being crossed: the picture that is about to come round is put in the
   *  neighbouring slot so the eye sees it arrive from the right side. */
  const shift = new Map<number, number>();
  /** True while the loop is being crossed. The animation borrows a position
   *  that does not exist and normalises afterwards; a second step in the
   *  middle of that would leave the track somewhere between the two. */
  let crossing = false;
  /** Where the page stood when the picture was opened. */
  let heldAt = 0;
  let pushed = false;

  const wake = (root: HTMLElement): Live => {
    const big = root.querySelector<HTMLElement>('[data-ag-big]')!;
    const track = root.querySelector<HTMLElement>('[data-ag-track]')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.ag-slide')];
    return {
      root, big, track, slides,
      view: root.querySelector<HTMLElement>('[data-ag-view]')!,
      photos: slides.map((s) => s.querySelector('img')!),
      at: root.querySelector<HTMLElement>('[data-ag-at]')!,
      loop: root.hasAttribute('data-ag-loop'),
      fly: root.hasAttribute('data-ag-fly'),
      index: 0, vw: 0, scale: 1, tx: 0, ty: 0,
    };
  };

  const measure = () => { if (live) live.vw = live.view.clientWidth; };

  /** Only the picture in the middle and its two neighbours are fetched —
   *  and with a loop, the neighbours of the last one are the first one. */
  const lazy = () => {
    if (!live) return;
    const n = live.slides.length;
    for (const d of [0, 1, -1]) {
      const j = live.loop ? (live.index + d + n) % n : live.index + d;
      const photo = live.photos[j];
      if (photo && !photo.src && photo.dataset.src) { photo.src = photo.dataset.src; softly(photo); }
    }
  };

  /** The track at a drag offset in pixels. Neighbours shrink and sink a
   *  little, growing back to full size as they reach the middle. Per cent
   *  for the step and pixels for the drag: per cent avoids the sub-pixel
   *  drift that viewport units bring on a phone. */
  /** One slide at position `v`, seen from `focus`. `v` is usually the
   *  slide's own index; while a loop is crossed it is the borrowed place. */
  const place = (i: number, v: number, focus: number, anim: boolean) => {
    const slide = live!.slides[i]!;
    const off = Math.min(1.2, Math.abs(v - focus));
    slide.style.transition = anim ? `transform 0.3s ${EASE}, opacity 0.3s ease` : 'none';
    slide.style.transform =
      `translate3d(${(v - i) * 100}%, 0, 0) translate3d(0, ${16 * off}px, 0) scale(${1 - 0.16 * off})`;
    slide.style.opacity = String(clamp(1 - 0.28 * off, 0, 1));
  };

  const draw = (drag: number, anim: boolean) => {
    if (!live) return;
    const { track, slides, index, vw, loop } = live;
    const n = slides.length;
    const focus = index + drag / (vw || 1);
    track.style.transition = anim ? `transform 0.3s ${EASE}` : 'none';
    track.style.transform = `translate3d(calc(${-index * 100}% + ${drag}px), 0, 0)`;

    // Dragged past an end with the loop on, the picture that would come
    // round is already put in the empty slot, so the preview does not show
    // a gap where the next picture belongs.
    if (loop && n > 1) {
      if (focus < 0) shift.set(n - 1, -1); else shift.delete(n - 1);
      if (focus > n - 1) shift.set(0, n); else shift.delete(0);
    }
    for (let i = 0; i < n; i++) place(i, shift.get(i) ?? i, focus, anim);
  };

  const zoom = (anim: boolean) => {
    if (!live) return;
    const photo = live.photos[live.index];
    if (!photo) return;
    photo.style.transition = anim ? 'transform 0.25s ease' : 'none';
    photo.style.transform = `translate(${live.tx}px, ${live.ty}px) scale(${live.scale})`;
  };
  const unzoom = (anim: boolean) => {
    if (!live) return;
    live.scale = 1; live.tx = 0; live.ty = 0;
    zoom(anim);
  };
  /** A zoomed picture stays inside the frame — no empty margins. */
  const inside = () => {
    if (!live) return;
    const photo = live.photos[live.index];
    if (!photo) return;
    const maxX = Math.max(0, (photo.clientWidth * live.scale - live.view.clientWidth) / 2);
    const maxY = Math.max(0, (photo.clientHeight * live.scale - live.view.clientHeight) / 2);
    live.tx = clamp(live.tx, -maxX, maxX);
    live.ty = clamp(live.ty, -maxY, maxY);
  };

  const goTo = (i: number, anim: boolean) => {
    if (!live) return;
    const next = clamp(i, 0, live.slides.length - 1);
    if (next !== live.index) { unzoom(false); live.index = next; }
    live.at.textContent = String(live.index + 1);
    lazy();
    draw(0, anim);
  };

  /** Crossing the loop, with the same movement as any other change: the
   *  track glides to a position one past the end, where the picture that is
   *  coming round has been put; then the real position is restored without
   *  anything visible happening. Jumping the track back across every slide
   *  instead would read as a rewind, not as a step. */
  const cross = (dir: number, fromDrag: number) => {
    if (!live) return;
    const n = live.slides.length;
    if (n < 2) { draw(0, true); return; }
    const target = dir > 0 ? 0 : n - 1;
    const borrowed = dir > 0 ? n : -1;
    crossing = true;
    unzoom(false);
    shift.clear();
    shift.set(target, borrowed);

    const from = live.index + fromDrag / (live.vw || 1);
    live.track.style.transition = 'none';
    live.track.style.transform = `translate3d(calc(${-live.index * 100}% + ${fromDrag}px), 0, 0)`;
    for (let i = 0; i < n; i++) place(i, shift.get(i) ?? i, from, false);

    requestAnimationFrame(() => {
      if (!live) return;
      live.track.style.transition = `transform 0.3s ${EASE}`;
      live.track.style.transform = `translate3d(${-borrowed * 100}%, 0, 0)`;
      for (let i = 0; i < n; i++) place(i, shift.get(i) ?? i, borrowed, true);
    });

    window.setTimeout(() => {
      crossing = false;
      if (!live) { shift.clear(); return; }
      live.index = target;
      live.at.textContent = String(target + 1);
      shift.clear();
      lazy();
      draw(0, false);
    }, 330);
  };

  /** One picture forward or back. Everything that leafs goes through here —
   *  the buttons, the arrow keys and the end of a swipe. */
  const step = (dir: number, fromDrag = 0) => {
    if (!live || crossing) return;
    settle();
    const next = live.index + dir;
    if (live.loop && (next < 0 || next >= live.slides.length)) cross(dir, fromDrag);
    else goTo(next, true);
  };

  /** A picture on its way between the strip and the enlarged view (`fly`).
   *
   *  What travels is not the picture itself but a stand-in laid over the
   *  enlarged view: the real one sits inside a track that is being measured
   *  and placed at that very moment, and on the way in its file is usually
   *  not even loaded. The stand-in is laid out where the journey ENDS and
   *  moved by `transform` alone, so the browser turns it as one layer.
   *
   *  `flight` lands the one under way at once — whatever comes next (a step,
   *  closing, opening another) calls it first instead of running into it. */
  let flight: (() => void) | null = null;
  const settle = () => { const land = flight; flight = null; land?.(); };
  const FLY_IN = 380, FLY_OUT = 300;
  const calm = () => typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches;
  const loaded = (img: HTMLImageElement) => img.complete && img.naturalWidth > 0;
  const within = (r: DOMRect) => r.width > 0 && r.right > 0 && r.bottom > 0 && r.left < innerWidth && r.top < innerHeight;

  /** The stand-in, laid out at `at` inside `host`. */
  const ghostAt = (host: HTMLElement, src: string, at: DOMRect) => {
    const base = host.getBoundingClientRect();
    const ghost = document.createElement('img');
    ghost.className = 'ag-ghost';
    ghost.alt = '';
    ghost.draggable = false;
    ghost.src = src;
    Object.assign(ghost.style, {
      left: `${at.left - base.left}px`, top: `${at.top - base.top}px`,
      width: `${at.width}px`, height: `${at.height}px`,
    });
    host.append(ghost);
    return ghost;
  };
  /** The transform that makes something laid out at `at` look like `as`. */
  const morph = (at: DOMRect, as: DOMRect) =>
    `translate(${as.left - at.left}px, ${as.top - at.top}px) scale(${as.width / at.width}, ${as.height / at.height})`;

  /** Where the enlarged picture will stand once its file is there — worked
   *  out from the slide, for the moment before the large file has told its
   *  own size. The shape comes from the size the site gave (`data-w`,
   *  `data-h`), else from the thumbnail. A file is never drawn larger than
   *  it is, so with a known size the target stops there — guessed from the
   *  room alone, a small picture flew in too big and then shrank to its
   *  real size the moment it arrived. The border counts once: inside the
   *  constraints with `box-sizing: border-box`, on top of them otherwise. */
  const fitted = (slide: HTMLElement, photo: HTMLImageElement, thumb: HTMLImageElement, from: DOMRect) => {
    const box = slide.getBoundingClientRect();
    const pad = getComputedStyle(slide);
    const look = getComputedStyle(photo);
    const edge = parseFloat(look.borderLeftWidth) || 0;
    const left = box.left + parseFloat(pad.paddingLeft), top = box.top + parseFloat(pad.paddingTop);
    const maxW = box.width - parseFloat(pad.paddingLeft) - parseFloat(pad.paddingRight);
    const maxH = box.height - parseFloat(pad.paddingTop) - parseFloat(pad.paddingBottom);
    const nw = Number(photo.dataset.w) || 0, nh = Number(photo.dataset.h) || 0;
    const ratio = nw && nh ? nw / nh
      : thumb.naturalWidth && thumb.naturalHeight ? thumb.naturalWidth / thumb.naturalHeight
      : from.width / from.height;
    const inset = look.boxSizing === 'border-box' ? 2 * edge : 0;
    const roomW = maxW - inset, roomH = maxH - inset;
    let cw = Math.min(roomW, roomH * ratio), ch = cw / ratio;
    if (nw && nh && cw > nw) { cw = nw; ch = nh; }
    const w = cw + 2 * edge, h = ch + 2 * edge;
    return new DOMRect(left + (maxW - w) / 2, top + (maxH - h) / 2, w, h);
  };

  /** Backdrop, slides and buttons coming up (or going down) around the
   *  travelling picture. Held at the end so nothing flashes back before the
   *  caller has tidied up; the caller cancels them. */
  const fade = (l: Live, dir: 1 | -1, ms: number) => {
    const opts: KeyframeAnimationOptions = { duration: ms, easing: 'ease', fill: 'forwards', direction: dir > 0 ? 'normal' : 'reverse' };
    return [
      l.big.animate({ backgroundColor: ['transparent', getComputedStyle(l.big).backgroundColor] }, opts),
      ...[l.view, ...l.big.querySelectorAll<HTMLElement>('.ag-btn, .ag-count')]
        .map((el) => el.animate({ opacity: [0, 1] }, opts)),
    ];
  };

  /** From the strip into the enlarged view. `from` is where the thumbnail
   *  stood when it was clicked. */
  const arrive = (l: Live, thumb: HTMLImageElement, from: DOMRect) => {
    const photo = l.photos[l.index]!, slide = l.slides[l.index]!;
    if (calm() || !within(from) || typeof photo.animate !== 'function') return;
    const ready = loaded(photo);
    const to = ready ? photo.getBoundingClientRect() : fitted(slide, photo, thumb, from);
    if (!to.width || !to.height) return;

    const ghost = ghostAt(l.big, ready ? photo.currentSrc || photo.src : thumb.currentSrc || thumb.src, to);
    photo.style.visibility = 'hidden';
    thumb.style.visibility = 'hidden';
    const fades = fade(l, 1, FLY_IN);
    const move = ghost.animate({ transform: [morph(to, from), 'none'] }, { duration: FLY_IN, easing: EASE });

    const swap = () => { photo.style.visibility = ''; ghost.remove(); };
    const land = () => {
      move.cancel();
      for (const f of fades) f.cancel();
      thumb.style.visibility = '';
      if (loaded(photo)) { swap(); return; }
      // The large file is still on its way: the stand-in stays, now as part
      // of the slide, so it leafs away with it. When the file arrives and
      // turns out smaller than the room it was given, the stand-in closes
      // in on it first.
      const at = ghost.getBoundingClientRect();
      const home = slide.getBoundingClientRect();
      Object.assign(ghost.style, { left: `${at.left - home.left}px`, top: `${at.top - home.top}px` });
      slide.append(ghost);
      const arrived = () => {
        if (!ghost.isConnected) return;
        const real = photo.getBoundingClientRect(), now = ghost.getBoundingClientRect();
        const off = Math.abs(real.width - now.width) + Math.abs(real.left - now.left) + Math.abs(real.top - now.top);
        if (off < 2 || !real.width) { swap(); return; }
        ghost.animate({ transform: ['none', morph(now, real)] }, { duration: 180, easing: 'ease', fill: 'forwards' })
          .finished.then(swap, swap);
      };
      photo.addEventListener('load', arrived, { once: true });
      photo.addEventListener('error', swap, { once: true });
    };
    flight = land;
    move.finished.then(() => { if (flight === land) settle(); }, () => {});
  };

  /** The thumbnail of picture `i` to fly back to. In an endless strip every
   *  picture is there three times: the one nearest the middle of the strip. */
  const nearest = (root: HTMLElement, i: number, strip: HTMLElement | null) => {
    const all = [...root.querySelectorAll<HTMLImageElement>(`[data-ag-open="${i}"] img`)];
    if (all.length < 2 || !strip) return all[0] ?? null;
    const s = strip.getBoundingClientRect(), mid = s.left + s.width / 2;
    const off = (img: HTMLImageElement) => { const r = img.getBoundingClientRect(); return Math.abs(r.left + r.width / 2 - mid); };
    return all.reduce((a, b) => (off(b) < off(a) ? b : a));
  };

  /** From the enlarged view back into the strip. Returns false when there is
   *  nowhere to fly to; `done` then has to be called by the caller. */
  const leave = (l: Live, done: () => void): boolean => {
    const photo = l.photos[l.index];
    const strip = l.root.querySelector<HTMLElement>('[data-ag-strip]');
    const thumb = nearest(l.root, l.index, strip);
    if (!photo || !thumb || calm() || typeof photo.animate !== 'function') return false;
    const standIn = l.slides[l.index]!.querySelector<HTMLImageElement>('.ag-ghost');
    const shown = standIn ?? (loaded(photo) ? photo : null);
    if (!shown) return false;
    const from = shown.getBoundingClientRect();

    // The picture left on may not be the one that was opened, and its
    // thumbnail may be out of sight in the strip: bring it in first.
    const frame = thumb.closest<HTMLElement>('.ag-frame');
    if (strip && frame) {
      const s = strip.getBoundingClientRect(), f = frame.getBoundingClientRect();
      if (f.left < s.left || f.right > s.right) {
        strip.scrollTo({ left: strip.scrollLeft + f.left - s.left - (s.width - f.width) / 2, behavior: 'instant' });
      }
    }
    const to = thumb.getBoundingClientRect();
    if (!within(to) || !from.width || !from.height) return false;

    const ghost = ghostAt(l.big, shown.currentSrc || shown.src, from);
    standIn?.remove();
    photo.style.visibility = 'hidden';
    thumb.style.visibility = 'hidden';
    // The page is the visitor's again from the first moment, not only once
    // the picture has landed.
    l.big.style.pointerEvents = 'none';
    const fades = fade(l, -1, FLY_OUT);
    const move = ghost.animate({ transform: ['none', morph(from, to)] }, { duration: FLY_OUT, easing: EASE, fill: 'forwards' });
    const land = () => {
      done();
      move.cancel();
      for (const f of fades) f.cancel();
      ghost.remove();
      thumb.style.visibility = '';
      photo.style.visibility = '';
      l.big.style.pointerEvents = '';
    };
    flight = land;
    move.finished.then(() => { if (flight === land) settle(); }, () => {});
    return true;
  };

  /** Holding the page still, and giving it back where it stood.
   *
   *  `overflow: hidden` is not enough: it takes the bars, not the scrolling,
   *  and on iOS not even that. The body is taken out of the flow at the
   *  offset it was at, and that offset has to be remembered — a fixed body
   *  forgets and would come back at the top.
   *
   *  `history.scrollRestoration` is deliberately NOT touched. Setting it to
   *  `manual` while a picture was open looked like the fix for the browser
   *  putting the page at the top on the way back, and it cost a day: the
   *  setting belongs to the session history ENTRY and survives a reload. A
   *  visitor who reloaded with a picture open left that entry on `manual`
   *  for good, and from then on every reload of that page jumped to the top.
   *  What the browser needed instead was a history entry that knows the real
   *  scroll position — so the entry is pushed BEFORE the body is pinned, see
   *  `open`. */
  const hold = () => {
    heldAt = window.scrollY;
    document.body.style.top = `-${heldAt}px`;
    document.documentElement.classList.add('ag-held');
  };
  const release = () => {
    document.documentElement.classList.remove('ag-held');
    document.body.style.top = '';
    // `instant`, because a site may set `scroll-behavior: smooth` and
    // closing a picture would otherwise be a second of scenery flying past
    // on the way back to where one already was.
    const back = () => window.scrollTo({ top: heldAt, left: 0, behavior: 'instant' });
    back();
    requestAnimationFrame(back);
  };

  const open = (root: HTMLElement, i: number, thumb?: HTMLImageElement | null) => {
    settle();
    // Taken now: pinning the page takes its scrollbar, and the strip with it
    // moves a few pixels.
    const from = thumb?.getBoundingClientRect();
    live = wake(root);
    if (!live.slides.length) { live = null; return; }
    live.index = clamp(i, 0, live.slides.length - 1);
    live.big.classList.add('is-open');
    live.big.setAttribute('aria-hidden', 'false');
    // BEFORE pinning the body, and that order is the whole point: pushing a
    // new entry makes the page's entry save the position it is at, and a
    // pinned body reads as zero. Pinned first, the browser learnt »top« and
    // put the page there on the way back. One history entry, so the back
    // gesture on a phone closes the picture instead of leaving the site.
    if (!pushed) { history.pushState({ agOpen: true }, ''); pushed = true; }
    hold();
    lazy();
    unzoom(false);
    live.at.textContent = String(live.index + 1);
    // Measured only once it is visible and the body is pinned: hidden, the
    // width is zero and every slide would sit on top of the first.
    measure();
    draw(0, false);
    requestAnimationFrame(() => { measure(); draw(0, false); });
    if (live.fly && thumb && from) arrive(live, thumb, from);
  };

  const shut = () => {
    if (!live) return;
    settle();
    const l = live;
    const hide = () => {
      l.big.classList.remove('is-open');
      l.big.setAttribute('aria-hidden', 'true');
      for (const ghost of l.root.querySelectorAll('.ag-ghost')) ghost.remove();
      for (const photo of l.photos) photo.style.visibility = '';
    };
    // Released first either way: the thumbnail the picture flies back to
    // only stands where it will stay once the page has its scrollbar again.
    release();
    shift.clear();
    live = null;
    if (!l.fly || !leave(l, hide)) hide();
  };
  const close = () => { if (pushed) history.back(); else shut(); };
  window.addEventListener('popstate', () => { if (live) { pushed = false; shut(); } });

  /** A page that is going away while a picture is open has to be let go of
   *  first. The browser writes the scroll position into the history entry as
   *  it leaves, and a pinned body stands at zero — so reloading with a
   *  picture open came back at the top. Released here, it records the place
   *  the visitor was actually at. */
  window.addEventListener('pagehide', () => { if (live) release(); });

  // Nothing is bound up front: inside a `server:defer` island this script
  // runs long before the markup exists.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const opener = target.closest<HTMLElement>('[data-ag-open]');
    if (opener) {
      const root = opener.closest<HTMLElement>('[data-ag]');
      if (root) open(root, Number(opener.dataset.agOpen) || 0, opener.querySelector('img'));
      return;
    }

    // Not `step`: that is the function that leafs through the enlarged
    // picture, and a local of the same name shadowed it here. The buttons
    // threw instead of turning the page, and nothing said so.
    const nudge = target.closest<HTMLElement>('[data-ag-step]');
    if (nudge) {
      const strip = nudge.closest('[data-ag]')?.querySelector<HTMLElement>('[data-ag-strip]');
      const first = strip?.querySelector<HTMLElement>('.ag-frame');
      if (strip) {
        // Room on both sides first, so an endless strip never meets an end.
        // A click during a glide counts as motion.
        begin(strip);
        recentre(strip, motion.has(strip));
        const width = first ? first.getBoundingClientRect().width + 16 : 320;
        strip.scrollBy({ left: (Number(nudge.dataset.agStep) || 1) * width, behavior: calm() ? 'instant' : 'smooth' });
      }
      return;
    }

    if (!live) return;
    if (target.closest('[data-ag-close]')) { close(); return; }
    const go = target.closest<HTMLElement>('[data-ag-go]');
    if (go) step(Number(go.dataset.agGo) || 1);
  });

  document.addEventListener('keydown', (e) => {
    if (!live) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'ArrowRight') step(1);
    else return;
    e.preventDefault();
  });
  window.addEventListener('resize', () => { if (live) { measure(); draw(0, false); } });

  // Gestures: swipe with one finger, pinch with two, pan while zoomed,
  // double tap to zoom, a tap beside the picture closes.
  const pointers = new Map<number, { x: number; y: number }>();
  let startDist = 0, startScale = 1;
  let panSX = 0, panSY = 0, panTX = 0, panTY = 0;
  let dragSX = 0, drag = 0, dragging = false;
  let downX = 0, downY = 0, lastTap = 0;
  let downTarget: EventTarget | null = null;
  const twoDist = () => {
    const p = [...pointers.values()];
    return Math.hypot(p[0]!.x - p[1]!.x, p[0]!.y - p[1]!.y);
  };
  const onView = (e: Event) => live && (e.target as HTMLElement).closest('[data-ag-view]');

  document.addEventListener('pointerdown', (e) => {
    if (!onView(e)) return;
    settle();
    live!.view.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      startDist = twoDist(); startScale = live!.scale; dragging = false;
    } else {
      downX = e.clientX; downY = e.clientY; downTarget = e.target;
      if (live!.scale > 1) { panSX = e.clientX; panSY = e.clientY; panTX = live!.tx; panTY = live!.ty; }
      else { dragSX = e.clientX; drag = 0; dragging = true; }
    }
  });

  document.addEventListener('pointermove', (e) => {
    if (!live || !pointers.has(e.pointerId)) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      if (startDist > 0) {
        live.scale = clamp(startScale * (twoDist() / startDist), 1, MAX_ZOOM);
        inside();
        zoom(false);
      }
    } else if (live.scale > 1) {
      live.tx = panTX + (e.clientX - panSX);
      live.ty = panTY + (e.clientY - panSY);
      inside();
      zoom(false);
    } else if (dragging) {
      let d = e.clientX - dragSX;
      // Without the loop the first and the last resist, so the end of the
      // row is felt. With it there is no end to feel.
      if (!live.loop && ((live.index === 0 && d > 0) || (live.index === live.slides.length - 1 && d < 0))) {
        d *= 0.35;
      }
      drag = d;
      draw(drag, false);
    }
  });

  const endPointer = (e: PointerEvent) => {
    if (!live || !pointers.has(e.pointerId)) return;
    const moved = Math.hypot(e.clientX - downX, e.clientY - downY);
    pointers.delete(e.pointerId);
    if (pointers.size === 0) {
      if (live.scale > 1) { inside(); zoom(true); }
      else if (dragging) {
        dragging = false;
        const threshold = Math.min(90, (live.vw || live.view.clientWidth) * 0.16);
        // The offset travels with it: a loop crossed by a swipe starts from
        // where the finger let go, not from the middle.
        if (drag <= -threshold) step(1, drag);
        else if (drag >= threshold) step(-1, drag);
        else draw(0, true);
        drag = 0;
      } else {
        unzoom(true);
      }
      if (moved < 10) {
        const onPhoto = downTarget instanceof Element && downTarget.classList.contains('ag-photo');
        const now = Date.now();
        if (onPhoto) {
          if (now - lastTap < 300) {
            if (live.scale > 1) unzoom(true);
            else { live.scale = 2.5; live.tx = 0; live.ty = 0; zoom(true); }
            lastTap = 0;
          } else lastTap = now;
        } else {
          close();
        }
      }
    } else if (pointers.size === 1 && live.scale > 1) {
      const p = [...pointers.values()][0]!;
      panSX = p.x; panSY = p.y; panTX = live.tx; panTY = live.ty;
    }
  };
  document.addEventListener('pointerup', endPointer);
  document.addEventListener('pointercancel', endPointer);
</script>

<style is:global>
  /* GLOBAL, and every selector starts at `.ag`. The stylesheet has to reach
     the page as well as the inside of a server island, and `.ag-held` is put
     on <html>, which no component scope covers. */

  .ag {
    /* What a site is meant to set. Defaults are deliberately plain. */
    --ag-accent: #ff4d0d;
    --ag-backdrop: rgb(12 12 13 / 0.96);
    --ag-radius: 0;
    --ag-border: 4px;
    --ag-gap: 0.6rem;
    --ag-thumb: clamp(15rem, 32vw, 22rem);
    --ag-thumb-border: 0;
    --ag-on-dark: #fff;
    /* Motion. `--ag-fade`: how long a picture takes to fade in once loaded
       (`0s` = off). `--ag-reveal-rise`: how far the strip pictures rise while
       they settle in (`0px` = fade only). */
    --ag-fade: 0.5s;
    --ag-reveal-rise: 1.25rem;
    /* The strip arrows: how far in from the window edge they stand (set it to
       the page's content edge) and to which side (`flex-end`, `center`,
       `flex-start`). */
    --ag-edge: 1.5rem;
    --ag-steps-align: flex-end;
  }

  .ag-band { position: relative; }
  .ag-strip {
    display: flex;
    gap: var(--ag-gap);
    margin: 0;
    padding: 1.5rem 0 2rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* The ends dissolve into the background instead of cutting a photo in
       half with a hard edge. */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
  }
  .ag-strip::-webkit-scrollbar { display: none; }
  .ag-frame { flex: 0 0 auto; scroll-snap-align: center; }
  /* Too few pictures to go round: the copies go, the strip has ends. */
  .ag-strip[data-ag-short] [data-ag-copy] { display: none; }
  .ag-open {
    display: block;
    padding: 0;
    border: var(--ag-thumb-border);
    background: none;
    line-height: 0;
    cursor: pointer;
    border-radius: var(--ag-radius);
    overflow: hidden;
  }
  .ag-open img { height: var(--ag-thumb); width: auto; object-fit: cover; display: block; }
  .ag-open:hover img { filter: saturate(1.15); }

  /* The strip arrows are for a mouse. Where there is a finger they stay
     away — and that is decided by the POINTER, not by the width. A width can
     be reported wrong, and was: in device emulation the page was laid out at
     desk width inside a phone-sized window, the media query did not match,
     and full-size arrows stood on a phone screen. */
  .ag-steps { display: none; }
  @media (min-width: 60rem) and (pointer: fine) {
    .ag-steps {
      display: flex;
      justify-content: var(--ag-steps-align);
      gap: 0.75rem;
      padding-inline: var(--ag-edge);
    }
    .ag-step {
      display: grid;
      place-items: center;
      width: 52px; height: 52px;
      padding: 0 0 0.35rem;
      border: 3px solid currentColor;
      border-radius: var(--ag-radius);
      background: transparent;
      color: inherit;
      font: inherit;
      font-size: 2.4rem;
      line-height: 1;
      cursor: pointer;
      transition: transform 0.1s ease, background 0.15s ease, color 0.15s ease;
    }
    .ag-step:hover { background: var(--ag-accent); border-color: var(--ag-accent); color: var(--ag-on-dark); }
    .ag-step:active { transform: translate(3px, 3px); }
  }

  /* ── The enlarged picture ─────────────────────────────────────────────── */

  .ag-big {
    position: fixed;
    inset: 0 0 auto;
    height: 100vh;
    height: 100dvh;
    z-index: 100;
    display: none;
    background: var(--ag-backdrop);
  }
  .ag-big.is-open { display: block; }
  /* The page behind stands still. Put on <html> by the script, together with
     an offset in `body.style.top`. */
  html.ag-held, html.ag-held body { overflow: hidden; overscroll-behavior: none; }
  html.ag-held body { position: fixed; left: 0; right: 0; width: 100%; }

  .ag-view { position: absolute; inset: 0; overflow: hidden; touch-action: none; z-index: 1; }
  .ag-track { display: flex; height: 100%; will-change: transform; }
  .ag-slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    will-change: transform, opacity;
  }
  .ag-photo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border: var(--ag-border) solid var(--ag-accent);
    border-radius: var(--ag-radius);
    user-select: none;
    -webkit-user-drag: none;
    transform-origin: center center;
  }
  /* The stand-in that travels between the strip and the enlarged view
     (`fly`). Made by the script — reached because this sheet is global. */
  .ag-ghost {
    position: absolute;
    z-index: 2;
    box-sizing: border-box;
    max-width: none;
    margin: 0;
    object-fit: cover;
    border: var(--ag-border) solid var(--ag-accent);
    border-radius: var(--ag-radius);
    transform-origin: 0 0;
    will-change: transform;
    pointer-events: none;
    user-select: none;
  }
  /* Sits on the lower edge of the slide, above the counter. */
  .ag-caption {
    position: absolute;
    left: 50%;
    bottom: 4.1rem;
    transform: translateX(-50%);
    max-width: min(90%, 40rem);
    margin: 0;
    padding: 0.35rem 1rem;
    border-radius: var(--ag-radius);
    background: var(--ag-caption-bg, rgb(0 0 0 / 0.6));
    color: var(--ag-on-dark);
    font: inherit;
    text-align: center;
    pointer-events: none;
  }
  .ag-btn {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    border: 3px solid var(--ag-on-dark);
    border-radius: var(--ag-radius);
    background: transparent;
    color: var(--ag-on-dark);
    font: inherit;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.1s ease, background 0.15s ease;
  }
  .ag-btn:hover { background: var(--ag-accent); border-color: var(--ag-accent); }
  .ag-btn:active { transform: translate(3px, 3px); }
  .ag-close { top: 1rem; right: 1rem; width: 52px; height: 52px; font-size: 1.5rem; }
  .ag-prev, .ag-next {
    top: 50%; margin-top: -29px;
    width: 58px; height: 58px; font-size: 2.6rem; padding-bottom: 0.4rem;
  }
  .ag-prev { left: 1rem; }
  .ag-next { right: 1rem; }
  .ag-count {
    position: absolute;
    z-index: 3;
    bottom: 1.1rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.3rem 1rem;
    border-radius: var(--ag-radius);
    background: var(--ag-accent);
    color: var(--ag-on-dark);
    font: inherit;
